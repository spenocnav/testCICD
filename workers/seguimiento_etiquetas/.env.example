# Credencial obligatoria. Nunca escriba aquí una llave real.
CLOUDFLEET_API_KEY=

# API Cloudfleet
CLOUDFLEET_BASE_URL=https://fleet.cloudfleet.com/api/v1/
CLOUDFLEET_TIMEOUT_SECONDS=45
# La cuota es 30 requests/60 s. 2,1 s son 28,6/min: pegado al techo, y el bucket
# se vacia de forma recurrente. Medido en un ciclo real: 6 pausas de cuota, 137,5 s
# perdidos (40% del ciclo) y un ritmo efectivo de solo 20,5 llamadas/min.
# 2,5 s son 24/min, no tocan el techo y sostienen 24 llamadas/min sin pausas.
# Correr mas lento rinde mas.
CLOUDFLEET_MIN_REQUEST_INTERVAL_SECONDS=2.5
CLOUDFLEET_MAX_RETRIES=4
CLOUDFLEET_BACKOFF_BASE_SECONDS=1
CLOUDFLEET_RATE_LIMIT_FALLBACK_SECONDS=60

# Worker. 300 segundos define el objetivo nominal; backlog/429 pueden ampliarlo.
TRACKING_RUNTIME_DIR=./runtime
TRACKING_POLL_INTERVAL_SECONDS=300
# Lote deliberadamente conservador. La cuota de Cloudfleet es de la API KEY, no
# de este proceso: el worker por lote del paquete KPI usa la misma credencial y
# se lleva parte del cupo cuando corre. Medido en tres ciclos con configuracion
# identica: 0, 2 y 8 pausas de cuota (252 s, 323 s y 463 s).
# Con 150 activas y lote 60 son 66 llamadas por ciclo: 165 s a 2,5 s/llamada, y
# 330 s aun perdiendo la MITAD del throughput. El ciclo cabe en los dos casos.
TRACKING_MAX_ORDERS_PER_CYCLE=60
# SLA de COBERTURA: edad maxima aceptable del ultimo sondeo exitoso de una OT
# activa. No es "todas las activas por ciclo" -la cuota lo impide- sino "ninguna
# activa sin leer por mas de este tiempo". Decide `ready` y el exit code de
# --healthcheck, y acota la ventana de observacion, que es la precision de la
# hora del evento.
# 30 min es holgado para el fenomeno medido: las transiciones entre etiquetas
# duran de 12 a 96 horas, asi que +/-30 min es un error de 0,5% a 4%.
# Con 150 activas y lote 60: una ronda completa toma 3 ciclos = 900 s = 15 min,
# la mitad del presupuesto. El margen absorbe al otro consumidor de la cuota.
TRACKING_COVERAGE_SLA_SECONDS=1800
# Prioriza las OTs que la lista reporta como cambiadas (updatedAt/estado/etiqueta
# del campo de OT). La rotacion se conserva como red de seguridad. Ponga "false"
# para volver a rotacion pura.
TRACKING_CHANGE_DRIVEN=true
# Edad maxima de una ronda de rotacion antes de reportar cobertura estancada.
TRACKING_ROTATION_MAX_AGE_SECONDS=86400
TRACKING_MAX_ENRICHMENTS_PER_CYCLE=5
TRACKING_DISCOVERY_OVERLAP_SECONDS=120
# El scheduler externo usa este valor para programar `sync_order_catalog.py --mode full`.
TRACKING_RECONCILIATION_INTERVAL_MINUTES=1440
TRACKING_CATALOG_FROM_DATE=2021-01-01
TRACKING_ACTIVE_STATUSES=opened,onTechnicalCompletion
TRACKING_HEALTH_MAX_AGE_SECONDS=900
TRACKING_LOG_LEVEL=INFO

# Servidor del dashboard de referencia
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
