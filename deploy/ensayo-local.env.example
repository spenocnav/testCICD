# Plantilla del ENSAYO LOCAL en Docker Desktop (variante de
# production.env.example para una máquina de desarrollo, SIN integraciones
# externas).
#
#   copiar a -> deploy/production.env   (ya está en .gitignore)
#
# Diferencias con production.env.example:
#   - Las tres claves de integración quedan VACÍAS a propósito: el ensayo no
#     debe escribir en CloudFleet, Navi Vehículos ni MyGeotab.
#   - ENVIRONMENT lo fuerza deploy/compose.ops.yml a "staging" para que las
#     cookies funcionen sobre http://localhost. Este archivo NO manda ahí.
#
# Reglas que la API valida al arrancar (si fallan, el contenedor no levanta):
#   JWT_SECRET               >= 32 caracteres y >= 8 distintos
#   MASTER_FERNET_KEY        clave Fernet válida
#   POSTGRES_PASSWORD        != portal_clientes_dev
#   MINIO_ACCESS/SECRET_KEY  != minioadmin
#   BOOTSTRAP_ADMIN_PASSWORD >= 12 caracteres, != ChangeMe123!
#   NAVI_BASE_URL            debe empezar por https://
#   CORS_ORIGINS             no vacío
#
# Generar la clave Fernet:
#   docker run --rm python:3.12-slim sh -c "pip -q install cryptography && \
#     python -c 'from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())'"

ENVIRONMENT=staging
LOG_LEVEL=INFO

POSTGRES_USER=portal_clientes
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DB=portal_clientes
DATABASE_URL=postgresql+psycopg://portal_clientes:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/portal_clientes
DATABASE_URL_LOCAL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BOOTSTRAP_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=Administrador

# El navegador entra por http://localhost:3000 y el frontend habla con la API
# por el rewrite interno de Next.js, así que en la práctica no hay peticiones
# cross-origin. Este valor sólo satisface la validación de arranque.
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=novedades
NAVIFAULT_MINIO_BUCKET=navifault-manuals
MOTOR_CURVES_MINIO_BUCKET=motor-curves
MINIO_SECURE=false

MASTER_FERNET_KEY=REPLACE_WITH_FERNET_KEY

# --- Integraciones externas: VACÍAS EN EL ENSAYO ---------------------------
# Con estas claves vacías, Novedades y Escalamiento responden 503 y el sync
# maestro no corre. Es el comportamiento esperado y deseado: sin ellas, esta
# máquina NO puede escribir en los sistemas productivos.
NAVI_BASE_URL=https://vehiculos.proyectosnavi.dev
NAVI_API_KEY=
SYNC_INGEST_API_KEY=
CLOUDFLEET_API_KEY=
# CLOUDFLEET_ID_REPORTEDBY: DEBE quedar COMENTADA, no vacia. El campo es
# `int | None`: con la variable presente y vacia Pydantic recibe "" y la API
# no arranca (int_parsing). Solo ausente toma el valor None.
# Ojo: deploy/production.env.example la trae vacia -> un despliegue sin
# CloudFleet copiado tal cual NO levanta.
#CLOUDFLEET_ID_REPORTEDBY=
CLOUDFLEET_BASE_URL=https://fleet.cloudfleet.com/api/v1
CLOUDFLEET_METER_SYNC_ENABLED=false

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

WEB_PORT=3000

NAVIFAULT_LLM_ENABLED=false
NAVIFAULT_LLM_BASE_URL=
