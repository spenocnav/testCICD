# Copiar a deploy/production.env y reemplazar todos los valores REPLACE_*.
# No versionar deploy/production.env.
#
# Con ENVIRONMENT=production o staging la API y los workers se niegan a
# arrancar si queda algún REPLACE_*, un secreto de desarrollo, una key
# Fernet inválida, una contraseña corta o una integración por http://.
# El mensaje nombra la variable, nunca su valor.

ENVIRONMENT=production
LOG_LEVEL=INFO

POSTGRES_USER=portal_clientes
POSTGRES_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
POSTGRES_DB=portal_clientes
DATABASE_URL=postgresql+psycopg://portal_clientes:REPLACE_WITH_DATABASE_PASSWORD@postgres:5432/portal_clientes
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
DATABASE_APPLICATION_NAME=navi-portal-api
REDIS_URL=redis://redis:6379/0

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BOOTSTRAP_ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=Administrador

CORS_ORIGINS=https://portal.example.com
CORS_ORIGIN_REGEX=

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_SECRET_KEY
MINIO_BUCKET=novedades
NAVIFAULT_MINIO_BUCKET=navifault-manuals
MOTOR_CURVES_MINIO_BUCKET=motor-curves
MINIO_SECURE=false

# Cifra en reposo las credenciales de MyGeotab que llegan de Navi Vehículos.
# La API y el ETL de reportes (reportes-etl-worker) leen ESTE mismo archivo, así
# que la comparten sin configuración extra. Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_FERNET_KEY=REPLACE_WITH_FERNET_KEY

# Origen publico de Navi Vehiculos. Se usa el dominio y no una IP de LAN para
# que un cambio de servidor no rompa el sync maestro ni la descarga de curvas
# de motor. Debe ser https: httpx no sigue redirects, asi que un http:// aqui
# falla con HTTPStatusError 301 en vez de renegociar en silencio.
NAVI_BASE_URL=https://vehiculos.proyectosnavi.dev
NAVI_API_KEY=
# Secreto compartido para que procesos externos publiquen auditoría de syncs
# (POST /api/v1/data-quality/sync-runs). Vacío = endpoint deshabilitado.
SYNC_INGEST_API_KEY=

# CloudFleet: novedades y escalamiento de fallas. CLOUDFLEET_ID_REPORTEDBY es
# el identificador del usuario que figura como reportante; sin él, crear
# novedades y escalar fallas responde 503.
CLOUDFLEET_API_KEY=
CLOUDFLEET_ID_REPORTEDBY=
CLOUDFLEET_BASE_URL=https://fleet.cloudfleet.com/api/v1
CLOUDFLEET_REQUESTS_PER_MINUTE=30
CLOUDFLEET_METER_SYNC_ENABLED=true
CLOUDFLEET_METER_LOOKBACK_DAYS=7
# Dejar vacío si no existe una fuente configurada en CloudFleet.
CLOUDFLEET_METER_SOURCE_CODE=
CLOUDFLEET_METER_COMMENT=Lectura automática desde MyGeotab

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_DSN=

WEB_PORT=3000

# Comunicación al cliente en Navifault (servidor de inferencia interno,
# API compatible con OpenAI). Opcional: apagado, el módulo funciona igual.
NAVIFAULT_LLM_ENABLED=false
NAVIFAULT_LLM_BASE_URL=
NAVIFAULT_LLM_MODEL=local-qwen
