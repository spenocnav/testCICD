# ETL de reportes (InformesRendimiento). Copiar a .env junto a este archivo.
# El docker-compose del portal lo carga con env_file y sobreescribe las URLs de
# base de datos con DATABASE_URL, así que dentro del compose basta con fijar
# MASTER_FERNET_KEY.

# Data maestra: base del portal (schema public) de donde se leen vehículos,
# reglas y las credenciales de MyGeotab que registra Navi Vehículos.
# La key Fernet descifra esas credenciales y debe ser la MISMA que usa la API.
MASTER_DB_URL=postgresql+psycopg://portal_clientes:portal_clientes_dev@localhost:5433/portal_clientes
MASTER_FERNET_KEY=

# Destino analytics (capa load/): la misma base del portal, schema analytics.
# Si se omite, el pipeline corre sin cargar a PostgreSQL.
ANALYTICS_DB_URL=postgresql+psycopg://portal_clientes:portal_clientes_dev@localhost:5433/portal_clientes
ANALYTICS_DB_SCHEMA=analytics

# Carril FaultData de baja latencia para Navifault, dentro del mismo worker:
# un GetFeed inmediato y luego cada ETL_FAULTS_INTERVAL_SECONDS.
ETL_FAULTS_REALTIME_ENABLED=false
ETL_FAULTS_INTERVAL_SECONDS=300
ETL_FAULTS_FEED_RESULTS_LIMIT=5000

# ---- Opcionales (valores por defecto entre paréntesis) ----------------------
# Dónde escribe el ETL. Sin definir, junto al código (desarrollo con bind mount).
# La imagen de producción los fija a /var/lib/etl/{data_lake,state}.
# ETL_DATA_LAKE_DIR=
# ETL_STATE_DIR=
# Worker: sondeo de disparos del portal (15 s), techo por paso (3 h) y
# programación propia (apagada: la cadena diaria la dispara daily-sync-worker).
# ETL_TRIGGER_POLL_SECONDS=15
# ETL_STEP_TIMEOUT_SECONDS=10800
# ETL_SCHEDULE_ENABLED=false
# ETL_SCHEDULE_INTERVAL_SECONDS=86400
# Dominios apagados de punta a punta y datasets en streaming.
# ETL_DISABLED_DOMAINS=ubicaciones,altimetria,consumo_def
# ETL_STREAMING_DATASETS=factor_carga
# ETL_STREAM_MAX_EXTRACTORS=4
# ETL_STREAM_QUEUE_SIZE=8
# Conexiones a PostgreSQL del ETL (pequeñas a propósito: comparte base con la API).
# ETL_DB_POOL_SIZE=2
# ETL_DB_MAX_OVERFLOW=0
# Extracción de ralentí: hilos (uno por credencial, tope) y consolidación.
# ETL_RALENTI_MAX_WORKERS=4
# ETL_RALENTI_MERGE_GAP_SECONDS=60
# Sesiones MyGeotab en caché (6 días) y arranque para vehículos sin estado.
# GEOTAB_SESSION_MAX_AGE_SECONDS=518400
# EXTRACTION_DEFAULT_LOOKBACK_DAYS=0
# Reconciliación: re-upsertear todo en la próxima carga.
# LOAD_FULL_UPSERT=false

# ---- Respaldo sin data maestra (no usar en el compose) ----------------------
# Si MASTER_DB_URL no está definida, el ETL cae a credenciales fijas por base,
# numeradas por prefijo de base: <BASE>_USER_1 / <BASE>_PASS_1, _2, ...
# Es un camino de emergencia para correr un script a mano; en el portal las
# credenciales viven en la base y se administran desde Navi Vehículos.
# NAVITRANS_USER_1=
# NAVITRANS_PASS_1=
