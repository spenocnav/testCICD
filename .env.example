# ===== Postgres =====
POSTGRES_USER=portal_clientes
POSTGRES_PASSWORD=portal_clientes_dev
POSTGRES_DB=portal_clientes
POSTGRES_PORT=5433

# ===== Redis =====
REDIS_PORT=6379

# ===== API (FastAPI) =====
API_PORT=8000
API_HOST=0.0.0.0
DATABASE_URL=postgresql+psycopg://portal_clientes:portal_clientes_dev@postgres:5432/portal_clientes
DATABASE_URL_LOCAL=postgresql+psycopg://portal_clientes:portal_clientes_dev@localhost:5433/portal_clientes
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=60000
DATABASE_APPLICATION_NAME=navi-portal-api
REDIS_URL=redis://redis:6379/0
REDIS_URL_LOCAL=redis://localhost:6379/0

# JWT — cambiar en producción
JWT_SECRET=change-me-in-prod-32-chars-min-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Housekeeping de sesiones: intervalo, retención forense y lote máximo.
REFRESH_TOKEN_PURGE_INTERVAL_SECONDS=3600
REFRESH_TOKEN_PURGE_RETENTION_SECONDS=604800
REFRESH_TOKEN_PURGE_BATCH_SIZE=1000

# CORS
CORS_ORIGINS=http://localhost:3000

# Data maestra — key Fernet para cifrar credenciales geotab en reposo.
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Debe ser la MISMA key configurada en InformesRendimiento.
MASTER_FERNET_KEY=

# ===== Sync data maestra (Navi Vehículos) =====
# Base URL de Navi Vehículos (sin /api/v1; el cliente lo agrega).
NAVI_BASE_URL=http://localhost:8000
# Token de integración: una de las INTEGRATION_API_KEYS de Navi Vehículos.
NAVI_API_KEY=
SYNC_HTTP_TIMEOUT_SECONDS=120
DATA_QUALITY_STALE_HOURS=48
# Secreto compartido para la ingesta de auditoría de syncs externos
# (InformesRendimiento -> POST /api/v1/data-quality/sync-runs, header
# X-Sync-Ingest-Key). Vacío = endpoint deshabilitado (503).
SYNC_INGEST_API_KEY=

# ===== Cloudfleet (Novedades) =====
CLOUDFLEET_API_KEY=
CLOUDFLEET_ID_REPORTEDBY=
CLOUDFLEET_BASE_URL=https://fleet.cloudfleet.com/api/v1
CLOUDFLEET_TIMEOUT_SECONDS=30
CLOUDFLEET_REQUESTS_PER_MINUTE=30
# Antes de traer la réplica CloudFleet, actualiza acumulados desde MyGeotab.
# sourceCode es opcional: configurarlo solo si ya existe en CloudFleet.
CLOUDFLEET_METER_SYNC_ENABLED=true
CLOUDFLEET_METER_LOOKBACK_DAYS=7
CLOUDFLEET_METER_SOURCE_CODE=
CLOUDFLEET_METER_COMMENT=Lectura automática desde MyGeotab

# ===== MinIO / evidencias de novedades, manuales y curvas de motor =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=novedades
NAVIFAULT_MINIO_BUCKET=navifault-manuals
MOTOR_CURVES_MINIO_BUCKET=motor-curves
MINIO_SECURE=false
# Puertos de host expuestos por MinIO (el endpoint interno siempre es minio:9000).
# Cámbialos si otro MinIO en el host ya usa 9000/9001.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bootstrap admin (Fase 2 seed)
BOOTSTRAP_ADMIN_EMAIL=admin@portalclientes.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Administrador

# Entorno
ENVIRONMENT=development
LOG_LEVEL=INFO

# ===== Web (Next.js) =====
WEB_PORT=3000
# Sólo para correr `pnpm dev` fuera de Docker. Dentro del compose el web llega a
# la API por API_PROXY_TARGET=http://api:8000, que fija el propio compose.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Sentry (opcional, Fase 7)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_DSN=

# ===== Opcionales (valores por defecto; descomentar para cambiarlos) =====
# Cadena diaria: maestra -> reportes (ETL) -> CloudFleet -> estado de novedades.
# DAILY_SYNC_ENABLED=true
# DAILY_SYNC_AT=04:00
# DAILY_SYNC_TIMEZONE=America/Bogota
# DAILY_SYNC_ETL_TIMEOUT_SECONDS=21600
# Vigilancia de novedades escaladas desde Navifault (CloudFleet no ofrece webhook).
# NAVIFAULT_ESCALATION_WATCH_ENABLED=true
# NAVIFAULT_ESCALATION_WATCH_INTERVAL_SECONDS=900
# Comunicación al cliente redactada por un servidor de inferencia interno
# (API compatible con OpenAI). Apagado por defecto: sin él, Navifault funciona
# igual y sólo omite ese texto.
# NAVIFAULT_LLM_ENABLED=false
# NAVIFAULT_LLM_BASE_URL=
# NAVIFAULT_LLM_MODEL=local-qwen
# Navegación por los enlaces internos del manual en el visor (en pruebas).
# NAVIFAULT_CORPUS_NAVIGATION_ENABLED=false
# Zona horaria de los cortes diarios de reportes y MyGeotab.
# REPORTES_TIMEZONE=America/Bogota
# GEOTAB_API_HOST=my.geotab.com
# Auditoría de uso del portal (tabla usage_events, retención en días).
# USAGE_TRACKING_ENABLED=true
# USAGE_RETENTION_DAYS=365
# Hilos para bcrypt fuera del event loop; bajarlo si la API tiene < 4 núcleos.
# PASSWORD_HASH_MAX_CONCURRENCY=4
